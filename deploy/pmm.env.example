# Polymarket maker service configuration.
# Copy to /etc/pmm-mm/pmm.env, chmod 600, and fill in the secrets.
# Never commit a filled-in copy.

# --- Identity ---------------------------------------------------------------
# Private key of the account signer EOA. Signs orders and relayer batches.
POLY_OWNER_PK=

# Wallet that holds the funds (proxy wallet or Deposit Wallet).
POLY_FUNDER=

# 0 EOA, 1 POLY_PROXY, 2 GNOSIS_SAFE, 3 POLY_1271. Leave unset to derive.
POLY_SIGNATURE_TYPE=

# --- CLOB L2 credentials ----------------------------------------------------
# Deterministically derived from POLY_OWNER_PK by an L1 signature.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Relayer (merge / redeem only) ------------------------------------------
# Create under Settings > API Keys > Relayer API Keys on polymarket.com.
POLY_RELAYER_API_KEY=
POLY_RELAYER_ADDRESS=

# --- Mode -------------------------------------------------------------------
# Arguments the quote loop runs with. Add --paper for a dry paper run.
PMM_RUN_ARGS=--interval 20 --capital 23 --size 20

# 1 records intents and sends nothing. Defaults to 1 when POLY_OWNER_PK is unset.
POLY_DRY_RUN=1
POLY_POST_ONLY=1

# --- Paths ------------------------------------------------------------------
POLY_JOURNAL_PATH=/var/lib/pmm/journal
POLY_PARAMS_PATH=/var/lib/pmm/params.json
POLY_REPORTS_DIR=/var/lib/pmm/reports

# --- Venue ------------------------------------------------------------------
POLY_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_HEARTBEAT_SECONDS=5
POLY_MAX_BATCH=15
